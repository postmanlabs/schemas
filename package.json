{
  "name": "postman-schemas",
  "version": "0.0.1",
  "description": "Tools and data related to Postman's JSON-based file formats, with a TanStack Start schema viewer",
  "homepage": "https://github.com/postmanlabs/schemas",
  "bugs": "https://github.com/postmanlabs/schemas/issues",
  "repository": {
    "type": "git",
    "url": "git://github.com/postmanlabs/schemas.git"
  },
  "author": "Postman Labs <help@getpostman.com> (=)",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "keywords": [
    "postman",
    "collection",
    "json-schema"
  ],
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@10.28.0",
  "pnpm": {
    "overrides": {
      "@types/react": "^18.3.1",
      "@types/react-dom": "^18.3.1"
    },
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "scripts": {
    "generate:schemas": "node scripts/generate-schemas.mjs",
    "generate:favicon": "node scripts/generate-favicon.mjs",
    "generate": "pnpm generate:schemas && pnpm generate:favicon",
    "build:packages": "pnpm --filter \"./packages/*\" build",
    "predev": "pnpm build:packages && pnpm generate",
    "dev": "vite dev",
    "prebuild": "pnpm build:packages && pnpm generate",
    "build": "vite build",
    "build:cf": "pnpm run build",
    "preview": "vite preview",
    "preview:cf": "pnpm build:cf && wrangler dev",
    "deploy": "pnpm build:cf && wrangler deploy",
    "typecheck": "tsc --noEmit && pnpm --filter \"./packages/*\" typecheck",
    "test": "vitest run",
    "compile": "node bin/compile.js",
    "validate": "node bin/validate.js"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource/inter": "^5.3.0",
    "@postman/json-schema-viewer": "workspace:*",
    "@reactuses/core": "^6.5.6",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.1",
    "ajv": "6.12.4",
    "commander": "6.1.0",
    "fs-extra": "9.0.1",
    "lodash": "4.17.20",
    "mustache": "4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "7.3.2",
    "strip-json-comments": "3.1.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^26.5.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "png-to-ico": "^3.0.2",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.151.0"
  }
}
