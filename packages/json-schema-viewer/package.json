{
  "name": "@postman/json-schema-viewer",
  "version": "4.16.4",
  "description": "SSR-friendly fork of @stoplight/json-schema-viewer, vendored for the Postman schemas site",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "styles.css",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./styles.css": "./styles.css"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@postman/json-schema-tree": "workspace:*",
    "@stoplight/json": "^3.20.1",
    "@stoplight/react-error-boundary": "^2.0.0",
    "@stoplight/types": "^13.20.0",
    "classnames": "^2.2.6",
    "jotai": "^1.4.5",
    "markdown-it": "^14.1.0"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/json-schema": "^7.0.15",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.0",
    "typescript": "^5.7.3"
  }
}
