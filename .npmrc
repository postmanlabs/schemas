# Let pnpm provision and run scripts with the Node version this project targets,
# regardless of the Node version the pnpm binary itself was bundled with.
use-node-version=24.21.0

# Do not hard-fail on the engines check. The bundled Node in some pnpm installs
# (e.g. Homebrew) can be older than engines.node and would otherwise block all
# commands. `.nvmrc` + engines.node still document the Node 24 requirement.
engine-strict=false
